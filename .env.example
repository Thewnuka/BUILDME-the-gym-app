# Copy to .env and adjust. Never commit the real .env file.

# --- Core -------------------------------------------------------------
DJANGO_DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS in production, e.g. https://gym.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/

GYM_NAME=BUILDME
# Let visitors create their own Member accounts from the login page.
REGISTRATION_ENABLED=True
TIME_ZONE=Asia/Colombo
CURRENCY_SYMBOL=LKR

# --- Members & memberships ------------------------------------------------
MEMBER_ID_PREFIX=BM
PHONE_DEFAULT_COUNTRY_CODE=94
MEMBER_PHOTO_MAX_KB=2048
MEMBERSHIP_EXPIRING_SOON_DAYS=7
MEMBERSHIP_MAX_BACKDATE_DAYS=31
MEMBERSHIP_MAX_ADVANCE_DAYS=90

# --- Payments & attendance -------------------------------------------------
PAYMENT_MAX_BACKDATE_DAYS=365
ATTENDANCE_QR_PREFIX=BUILDME-CHECKIN

# --- Training (Phase 4) ----------------------------------------------------
APPOINTMENT_MEMBER_CHANGE_CUTOFF_HOURS=24
APPOINTMENT_BOOKING_HORIZON_DAYS=30
APPOINTMENT_SLOT_STEP_MINUTES=30
APPOINTMENT_REMINDER_HOURS=24
TRAINER_FILE_MAX_KB=5120
NUTRITION_ENABLED=True

# --- Operations & notifications (Phase 5) ------------------------------------
EXPENSE_RECEIPT_MAX_KB=5120
MEMBERSHIP_EXPIRY_REMINDER_DAYS=7,1
PAYMENT_DUE_REMINDER_DAYS=3
EQUIPMENT_MAINTENANCE_REMINDER_DAYS=7
# External channels for member notifications: email,sms,whatsapp (empty = in-app only)
NOTIFY_CHANNELS=
# SMS: twilio or notifylk; WhatsApp: twilio. Leave empty to disable.
SMS_PROVIDER=
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
PUBLIC_BASE_URL=
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=
# Optional Celery + Redis, e.g. redis://localhost:6379/0 (see README)
CELERY_BROKER_URL=

# --- Files --------------------------------------------------------------
# Where uploads are stored (default: ./media). Must be private and backed up.
MEDIA_ROOT=
# Where collectstatic writes (default: ./staticfiles); served by WhiteNoise.
STATIC_ROOT=

# --- Database ---------------------------------------------------------
# Leave empty to use local SQLite (db.sqlite3).
# Production (PostgreSQL): postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
DB_CONN_MAX_AGE=60

# --- Email (password reset) --------------------------------------------
# Console backend prints emails to the terminal during development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@gym.local

# --- Security (applied when DJANGO_DEBUG=False) -------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False
# Set to True when running behind a proxy that sets X-Forwarded-Proto
USE_X_FORWARDED_PROTO=False

# --- Login throttling --------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_AGE=43200

# --- Cache (use a shared backend in multi-process production) ----------
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=gym-default

LOG_LEVEL=INFO
